+// MARK: - Fenix: arithmetic in the carb amount field ("28+28")
+
+/// Evaluates simple arithmetic typed into a carb amount field, e.g. "28+28" or "2*15+(10/2)".
+///
+/// Allowed: digits, one decimal point per number ("." or the locale's separator), + - * / (also
+/// − × ÷ x X), parentheses and spaces. No unary minus, no exponents, nothing else. Anything that is not a
+/// complete, valid expression -- a trailing operator, junk, unbalanced parentheses, division by zero, a
+/// result that is not a positive finite number -- is an error and never yields a number.
+///
+/// The result is rounded to `fractionDigits` (the amount field shows 1 decimal) and rejected when it has
+/// more than `maximumIntegerDigits` integer digits (the field's own formatter limit). It is only a
+/// number: the caller confirms it with the user and then feeds it into the normal entry path, where Loop's
+/// max carb entry check and every other validation still apply.
+public enum CarbAmountExpression {
+    public enum EvaluationError: Error, Equatable {
+        case empty
+        case invalidCharacter(Character)
+        case invalidNumber
+        case incomplete
+        case unbalancedParentheses
+        case divisionByZero
+        case notPositive
+        case tooLarge
+    }
+
+    /// True when `text` contains an operator or parenthesis, i.e. is more than a plain number.
+    public static func isExpression(_ text: String) -> Bool {
+        text.contains { operatorCharacters.contains($0) || $0 == "(" || $0 == ")" }
+    }
+
+    public static func evaluate(_ text: String, fractionDigits: Int = 1, maximumIntegerDigits: Int = 3,
+                                decimalSeparator: String = Locale.current.decimalSeparator ?? ".") throws -> Double {
+        let tokens = try tokenize(text, decimalSeparator: decimalSeparator)
+        guard !tokens.isEmpty else { throw EvaluationError.empty }
+        var parser = Parser(tokens: tokens)
+        let value = try parser.parseExpression()
+        guard parser.isAtEnd else {
+            throw parser.peek == .closeParen ? EvaluationError.unbalancedParentheses : EvaluationError.incomplete
+        }
+        guard value.isFinite else { throw EvaluationError.tooLarge }
+        let scale = pow(10.0, Double(fractionDigits))
+        let rounded = (value * scale).rounded() / scale
+        guard rounded > 0 else { throw EvaluationError.notPositive }
+        guard rounded < pow(10.0, Double(maximumIntegerDigits)) else { throw EvaluationError.tooLarge }
+        return rounded
+    }
+
+    private static let operatorCharacters: Set<Character> = ["+", "-", "−", "*", "×", "x", "X", "/", "÷"]
+
+    private enum Token: Equatable {
+        case number(Double)
+        case plus, minus, times, divide
+        case openParen, closeParen
+    }
+
+    private static func tokenize(_ text: String, decimalSeparator: String) throws -> [Token] {
+        var tokens: [Token] = []
+        var numberText = ""
+
+        func flushNumber() throws {
+            guard !numberText.isEmpty else { return }
+            // Exactly digits with at most one ".", and at least one digit.
+            let parts = numberText.split(separator: ".", omittingEmptySubsequences: false)
+            guard parts.count <= 2, parts.contains(where: { !$0.isEmpty }),
+                  let value = Double(numberText), value.isFinite else {
+                throw EvaluationError.invalidNumber
+            }
+            tokens.append(.number(value))
+            numberText = ""
+        }
+
+        for character in text {
+            if character.isASCII && character.isNumber {
+                numberText.append(character)
+            } else if character == "." || String(character) == decimalSeparator {
+                numberText.append(".")
+            } else {
+                try flushNumber()
+                switch character {
+                case " ": continue
+                case "+": tokens.append(.plus)
+                case "-", "−": tokens.append(.minus)
+                case "*", "×", "x", "X": tokens.append(.times)
+                case "/", "÷": tokens.append(.divide)
+                case "(": tokens.append(.openParen)
+                case ")": tokens.append(.closeParen)
+                default: throw EvaluationError.invalidCharacter(character)
+                }
+            }
+        }
+        try flushNumber()
+        return tokens
+    }
+
+    /// expression := term (("+" | "-") term)* ; term := factor (("*" | "/") factor)* ; factor := number | "(" expression ")"
+    private struct Parser {
+        let tokens: [Token]
+        var index = 0
+
+        var isAtEnd: Bool { index >= tokens.count }
+        var peek: Token? { isAtEnd ? nil : tokens[index] }
+
+        mutating func parseExpression() throws -> Double {
+            var value = try parseTerm()
+            while let token = peek, token == .plus || token == .minus {
+                index += 1
+                let rhs = try parseTerm()
+                value = token == .plus ? value + rhs : value - rhs
+            }
+            return value
+        }
+
+        mutating func parseTerm() throws -> Double {
+            var value = try parseFactor()
+            while let token = peek, token == .times || token == .divide {
+                index += 1
+                let rhs = try parseFactor()
+                if token == .times {
+                    value *= rhs
+                } else {
+                    guard rhs != 0 else { throw EvaluationError.divisionByZero }
+                    value /= rhs
+                }
+            }
+            return value
+        }
+
+        mutating func parseFactor() throws -> Double {
+            guard let token = peek else { throw EvaluationError.incomplete }
+            switch token {
+            case .number(let value):
+                index += 1
+                return value
+            case .openParen:
+                index += 1
+                let value = try parseExpression()
+                guard peek == .closeParen else {
+                    throw isAtEnd ? EvaluationError.unbalancedParentheses : EvaluationError.incomplete
+                }
+                index += 1
+                return value
+            case .closeParen:
+                throw EvaluationError.unbalancedParentheses
+            case .plus, .minus, .times, .divide:
+                throw EvaluationError.incomplete
+            }
+        }
+    }
+}
diff --git a/LoopKit/LoopKitTests/CarbValueTests.swift b/LoopKit/LoopKitTests/CarbValueTests.swift
index 702a552..68172a4 100644
--- a/LoopKit/LoopKitTests/CarbValueTests.swift
+++ b/LoopKit/LoopKitTests/CarbValueTests.swift
@@ -48,3 +48,77 @@ class CarbValueCodableTests: XCTestCase {
         return decoder
     }()
 }
+
+// Fenix: arithmetic in the carb amount field.
+class CarbAmountExpressionTests: XCTestCase {
+    private func value(_ text: String) throws -> Double {
+        try CarbAmountExpression.evaluate(text, decimalSeparator: ".")
+    }
+
+    private func assertError(_ text: String, _ expected: CarbAmountExpression.EvaluationError, file: StaticString = #filePath, line: UInt = #line) {
+        XCTAssertThrowsError(try value(text), text, file: file, line: line) { error in
+            XCTAssertEqual(error as? CarbAmountExpression.EvaluationError, expected, text, file: file, line: line)
+        }
+    }
+
+    func testSums() throws {
+        XCTAssertEqual(try value("28+28"), 56)
+        XCTAssertEqual(try value(" 28 + 28 "), 56)
+        XCTAssertEqual(try value("10+12.5+7"), 29.5)
+        XCTAssertEqual(try value("60-15"), 45)
+        XCTAssertEqual(try value("60−15"), 45)
+    }
+
+    func testPrecedenceAndParentheses() throws {
+        XCTAssertEqual(try value("2*15+10"), 40)
+        XCTAssertEqual(try value("10+2*15"), 40)
+        XCTAssertEqual(try value("(10+2)*3"), 36)
+        XCTAssertEqual(try value("2×15"), 30)
+        XCTAssertEqual(try value("2x15"), 30)
+        XCTAssertEqual(try value("45÷2"), 22.5)
+        XCTAssertEqual(try value("45/2"), 22.5)
+        XCTAssertEqual(try value("((5))"), 5)
+    }
+
+    func testRoundsLikeTheField() throws {
+        XCTAssertEqual(try value("10/3"), 3.3)
+        XCTAssertEqual(try value("20/3"), 6.7)
+        XCTAssertEqual(try value("0.25+0.25"), 0.5)
+    }
+
+    func testPlainNumberStillWorks() throws {
+        XCTAssertEqual(try value("45"), 45)
+        XCTAssertFalse(CarbAmountExpression.isExpression("45"))
+        XCTAssertFalse(CarbAmountExpression.isExpression("45.5"))
+        XCTAssertTrue(CarbAmountExpression.isExpression("28+28"))
+        XCTAssertTrue(CarbAmountExpression.isExpression("(28)"))
+    }
+
+    func testInvalidNeverGivesANumber() {
+        assertError("", .empty)
+        assertError("   ", .empty)
+        assertError("28+", .incomplete)
+        assertError("28+*2", .incomplete)
+        assertError("+28", .incomplete)
+        assertError("-5+10", .incomplete)
+        assertError("28 28", .incomplete)
+        assertError("28+abc", .invalidCharacter("a"))
+        assertError("28,5", .invalidCharacter(","))
+        assertError("1e3", .invalidCharacter("e"))
+        assertError("1.2.3", .invalidNumber)
+        assertError(".", .invalidNumber)
+        assertError("(28+2", .unbalancedParentheses)
+        assertError("28+2)", .unbalancedParentheses)
+        assertError("()", .unbalancedParentheses)
+        assertError("10/0", .divisionByZero)
+        assertError("10/(5-5)", .divisionByZero)
+        assertError("28-28", .notPositive)
+        assertError("10-20", .notPositive)
+        assertError("0.01", .notPositive)
+        assertError("999+1", .tooLarge)
+    }
+
+    func testLocaleDecimalSeparator() throws {
+        XCTAssertEqual(try CarbAmountExpression.evaluate("12,5+2,5", decimalSeparator: ","), 15)
+    }
+}
