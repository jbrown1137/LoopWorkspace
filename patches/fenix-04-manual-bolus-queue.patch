+// FENIX-QUEUE-TESTS-BEGIN
+// Fenix: manual bolus queue state machine (queue, deliver, expire, cancel, guard-fail).
+final class ManualBolusQueueTests: XCTestCase {
+    private let t0 = Date(timeIntervalSince1970: 1_800_000_000)
+
+    private func pod(busy: Bool = true, automatic: Bool = true, hasPod: Bool = true, suspended: Bool = false,
+                     notReady: String? = nil) -> ManualBolusQueue.PodSnapshot {
+        .init(hasPod: hasPod, isSuspended: suspended, isBusy: busy, isBusyWithAutomaticDelivery: busy && automatic, notReadyReason: notReady)
+    }
+
+    private func goodCheck(at date: Date, pod: ManualBolusQueue.PodSnapshot? = nil) -> ManualBolusQueue.DeliveryCheck {
+        .init(maximumBolus: 10, activeInsulin: 2, suspendThreshold: 75, latestGlucose: 180, latestGlucoseDate: date.addingTimeInterval(-120),
+              minimumForecastWithDose: 110, pod: pod ?? self.pod(busy: false))
+    }
+
+    private func queued(_ units: Double = 1.0) throws -> ManualBolusQueue {
+        var queue = ManualBolusQueue()
+        try queue.enqueue(units: units, decisionId: nil, activationTypeRawValue: "manualNoRecommendation", at: t0, pod: pod())
+        return queue
+    }
+
+    func testQueueThenDeliverWhenPodIsFree() throws {
+        var queue = try queued()
+        XCTAssertEqual(queue.checkExpiry(now: t0 + 30), .waiting(queue.item!))
+        XCTAssertEqual(queue.stepWhenFree(now: t0 + 60, check: goodCheck(at: t0 + 60, pod: pod(busy: true))), .waiting(queue.item!))
+        let item = queue.item!
+        XCTAssertEqual(queue.stepWhenFree(now: t0 + 90, check: goodCheck(at: t0 + 90)), .deliver(item))
+        XCTAssertNil(queue.item, "one attempt only")
+        XCTAssertEqual(queue.stepWhenFree(now: t0 + 95, check: goodCheck(at: t0 + 95)), .idle)
+    }
+
+    func testOnlyOneAtATime() throws {
+        var queue = try queued()
+        XCTAssertThrowsError(try queue.enqueue(units: 2, decisionId: nil, activationTypeRawValue: "x", at: t0, pod: pod())) {
+            XCTAssertEqual($0 as? ManualBolusQueue.QueueRefusal, .alreadyQueued)
+        }
+    }
+
+    func testNeverQueuesWhenSuspendedNoPodOrNotBusyWithAutomatic() {
+        let cases: [(ManualBolusQueue.PodSnapshot, ManualBolusQueue.QueueRefusal)] = [
+            (pod(suspended: true), .suspended),
+            (pod(hasPod: false), .noPod),
+            (pod(busy: false), .notBusyWithAutomaticDelivery),
+            (pod(busy: true, automatic: false), .notBusyWithAutomaticDelivery),
+        ]
+        for (snapshot, refusal) in cases {
+            var queue = ManualBolusQueue()
+            XCTAssertThrowsError(try queue.enqueue(units: 1, decisionId: nil, activationTypeRawValue: "x", at: t0, pod: snapshot)) {
+                XCTAssertEqual($0 as? ManualBolusQueue.QueueRefusal, refusal)
+            }
+            XCTAssertNil(queue.item)
+        }
+        var queue = ManualBolusQueue()
+        XCTAssertThrowsError(try queue.enqueue(units: 0, decisionId: nil, activationTypeRawValue: "x", at: t0, pod: pod()))
+    }
+
+    func testExpiresAfterTenMinutesAndIsNeverDeliveredLate() throws {
+        var queue = try queued()
+        let item = queue.item!
+        XCTAssertEqual(queue.checkExpiry(now: t0 + 599), .waiting(item))
+        XCTAssertEqual(queue.checkExpiry(now: t0 + 600), .expired(item))
+        XCTAssertNil(queue.item)
+
+        var late = try queued()
+        XCTAssertEqual(late.stepWhenFree(now: t0 + 601, check: goodCheck(at: t0 + 601)), .expired(item))
+    }
+
+    func testCancel() throws {
+        var queue = try queued()
+        XCTAssertEqual(queue.cancel()?.units, 1.0)
+        XCTAssertNil(queue.item)
+        XCTAssertEqual(queue.stepWhenFree(now: t0 + 60, check: goodCheck(at: t0 + 60)), .idle)
+        XCTAssertNil(queue.cancel())
+    }
+
+    func testGuardFailuresAreNotGivenAndNeverShrunk() throws {
+        let now = t0 + 60
+        var check: ManualBolusQueue.DeliveryCheck
+
+        func expect(_ check: ManualBolusQueue.DeliveryCheck, _ failure: ManualBolusQueue.GuardFailure, units: Double = 1.0, line: UInt = #line) throws {
+            var queue = try queued(units)
+            let item = queue.item!
+            XCTAssertEqual(queue.stepWhenFree(now: now, check: check), .notGiven(item, failure), line: line)
+            XCTAssertNil(queue.item, line: line)
+        }
+
+        check = goodCheck(at: now); check.maximumBolus = 0.5
+        try expect(check, .aboveMaximumBolus(maximum: 0.5))
+        check = goodCheck(at: now); check.maximumBolus = nil
+        try expect(check, .noMaximumBolus)
+        // IOB limit = 2 x max bolus, counting the automatic bolus that just finished.
+        check = goodCheck(at: now); check.maximumBolus = 3; check.activeInsulin = 5.5
+        try expect(check, .aboveActiveInsulinLimit(activeInsulin: 5.5, limit: 6))
+        check = goodCheck(at: now); check.activeInsulin = nil
+        try expect(check, .activeInsulinUnavailable)
+        check = goodCheck(at: now); check.latestGlucose = 70
+        try expect(check, .glucoseBelowSuspendThreshold(glucose: 70, threshold: 75))
+        check = goodCheck(at: now); check.latestGlucoseDate = now - 16 * 60
+        try expect(check, .glucoseUnavailable)
+        check = goodCheck(at: now); check.minimumForecastWithDose = 74
+        try expect(check, .forecastBelowSuspendThreshold(forecast: 74, threshold: 75))
+        check = goodCheck(at: now); check.minimumForecastWithDose = nil
+        try expect(check, .forecastUnavailable)
+        check = goodCheck(at: now); check.suspendThreshold = nil
+        try expect(check, .noSuspendThreshold)
+        check = goodCheck(at: now, pod: pod(busy: false, notReady: "pod is suspended"))
+        try expect(check, .podNotReady("pod is suspended"))
+    }
+
+    func testExactLimitsPass() throws {
+        let now = t0 + 60
+        var check = goodCheck(at: now); check.maximumBolus = 1; check.activeInsulin = 1; check.minimumForecastWithDose = 75
+        var queue = try queued(1)
+        let item = queue.item!
+        XCTAssertEqual(queue.stepWhenFree(now: now, check: check), .deliver(item))
+    }
+}
+// FENIX-QUEUE-TESTS-END
