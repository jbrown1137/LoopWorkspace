+// MARK: - Fenix: manual bolus queue (ROADMAP E). Default OFF.
+//
+// When the pod is busy with an automatic bolus and Jeff asks for a manual one, Loop can ask "Queue your X U to go
+// right after it?" instead of the stock behavior. A queued bolus is delivered once, through the normal manual-bolus
+// path, as soon as the pod is free -- and only if every delivery-time check passes. It is never shrunk, never retried,
+// never delivered later than `ManualBolusQueue.expiry` after queuing.
+
+// FENIX-QUEUE-CORE-BEGIN (pure Foundation; the unit tests exercise this part)
+/// The queue's state machine: one item at most, and the decision of what to do with it at each step.
+struct ManualBolusQueue: Equatable {
+    static let expiry: TimeInterval = 10 * 60
+    /// The glucose used for the check must be at most this old (Loop's own input recency).
+    static let glucoseRecency: TimeInterval = 15 * 60
+
+    struct Item: Equatable {
+        var units: Double
+        var queuedAt: Date
+        var decisionId: UUID?
+        var activationTypeRawValue: String
+    }
+
+    /// What the pod is doing when a bolus is asked for, or when the queue looks again.
+    struct PodSnapshot: Equatable {
+        var hasPod: Bool
+        var isSuspended: Bool
+        /// The pod cannot take a bolus now (one is initiating, running or canceling).
+        var isBusy: Bool
+        /// The running delivery is an automatic bolus (or one is initiating). Only then may a manual bolus queue.
+        var isBusyWithAutomaticDelivery: Bool
+        /// Pod present, not suspended, not inoperable: a bolus could be programmed. Reason when not.
+        var notReadyReason: String?
+    }
+
+    enum QueueRefusal: Error, Equatable {
+        case alreadyQueued
+        case noPod
+        case suspended
+        case notBusyWithAutomaticDelivery
+        case invalidAmount
+    }
+
+    /// The checks a manual bolus gets, re-done when the queued one is about to go.
+    struct DeliveryCheck: Equatable {
+        var maximumBolus: Double?
+        /// Loop's active insulin now, including the automatic bolus that just finished.
+        var activeInsulin: Double?
+        /// Loop's IOB limit multiplier on max bolus (the algorithm's default is 2).
+        var maxActiveInsulinMultiplier: Double = 2
+        var suspendThreshold: Double?
+        var latestGlucose: Double?
+        var latestGlucoseDate: Date?
+        /// Lowest forecast glucose with this bolus included.
+        var minimumForecastWithDose: Double?
+        var pod: PodSnapshot
+    }
+
+    enum GuardFailure: Equatable {
+        case noMaximumBolus
+        case aboveMaximumBolus(maximum: Double)
+        case activeInsulinUnavailable
+        case aboveActiveInsulinLimit(activeInsulin: Double, limit: Double)
+        case noSuspendThreshold
+        case glucoseUnavailable
+        case glucoseBelowSuspendThreshold(glucose: Double, threshold: Double)
+        case forecastUnavailable
+        case forecastBelowSuspendThreshold(forecast: Double, threshold: Double)
+        case podNotReady(String)
+    }
+
+    enum Step: Equatable {
+        case idle
+        case waiting(Item)
+        case deliver(Item)
+        case expired(Item)
+        case notGiven(Item, GuardFailure)
+    }
+
+    private(set) var item: Item?
+
+    @discardableResult
+    mutating func enqueue(units: Double, decisionId: UUID?, activationTypeRawValue: String, at date: Date, pod: PodSnapshot) throws -> Item {
+        guard item == nil else { throw QueueRefusal.alreadyQueued }
+        guard units > 0, units.isFinite else { throw QueueRefusal.invalidAmount }
+        guard pod.hasPod else { throw QueueRefusal.noPod }
+        guard !pod.isSuspended else { throw QueueRefusal.suspended }
+        guard pod.isBusyWithAutomaticDelivery else { throw QueueRefusal.notBusyWithAutomaticDelivery }
+        let newItem = Item(units: units, queuedAt: date, decisionId: decisionId, activationTypeRawValue: activationTypeRawValue)
+        item = newItem
+        return newItem
+    }
+
+    /// Removes the queued bolus; returns it if there was one.
+    @discardableResult
+    mutating func cancel() -> Item? {
+        defer { item = nil }
+        return item
+    }
+
+    /// Expired, or still waiting. Called on every poll before any checks are gathered.
+    mutating func checkExpiry(now: Date) -> Step {
+        guard let item else { return .idle }
+        if now.timeIntervalSince(item.queuedAt) >= Self.expiry {
+            self.item = nil
+            return .expired(item)
+        }
+        return .waiting(item)
+    }
+
+    /// The pod is free: deliver, or say why not. Either way the item leaves the queue -- one attempt only.
+    mutating func stepWhenFree(now: Date, check: DeliveryCheck) -> Step {
+        guard let item else { return .idle }
+        if now.timeIntervalSince(item.queuedAt) >= Self.expiry {
+            self.item = nil
+            return .expired(item)
+        }
+        if check.pod.isBusy {
+            return .waiting(item)
+        }
+        self.item = nil
+        if let failure = Self.guardFailure(units: item.units, now: now, check: check) {
+            return .notGiven(item, failure)
+        }
+        return .deliver(item)
+    }
+
+    static func guardFailure(units: Double, now: Date, check: DeliveryCheck) -> GuardFailure? {
+        if let reason = check.pod.notReadyReason { return .podNotReady(reason) }
+        if !check.pod.hasPod { return .podNotReady("no pod") }
+        if check.pod.isSuspended { return .podNotReady("pod is suspended") }
+
+        guard let maximumBolus = check.maximumBolus else { return .noMaximumBolus }
+        guard units <= maximumBolus + 1e-9 else { return .aboveMaximumBolus(maximum: maximumBolus) }
+
+        guard let activeInsulin = check.activeInsulin else { return .activeInsulinUnavailable }
+        let limit = maximumBolus * check.maxActiveInsulinMultiplier
+        guard activeInsulin + units <= limit + 1e-9 else {
+            return .aboveActiveInsulinLimit(activeInsulin: activeInsulin, limit: limit)
+        }
+
+        guard let threshold = check.suspendThreshold else { return .noSuspendThreshold }
+        guard let glucose = check.latestGlucose, let glucoseDate = check.latestGlucoseDate,
+              now.timeIntervalSince(glucoseDate) <= glucoseRecency, glucoseDate.timeIntervalSince(now) <= glucoseRecency else {
+            return .glucoseUnavailable
+        }
+        guard glucose >= threshold else { return .glucoseBelowSuspendThreshold(glucose: glucose, threshold: threshold) }
+
+        guard let forecast = check.minimumForecastWithDose else { return .forecastUnavailable }
+        guard forecast >= threshold else { return .forecastBelowSuspendThreshold(forecast: forecast, threshold: threshold) }
+        return nil
+    }
+
+    static func describe(_ failure: GuardFailure) -> String {
+        func n(_ value: Double) -> String { String(format: "%.1f", value) }
+        func g(_ value: Double) -> String { String(format: "%.0f", value) }
+        switch failure {
+        case .noMaximumBolus: return "no max bolus is set"
+        case .aboveMaximumBolus(let maximum): return "over max bolus (\(n(maximum)) U)"
+        case .activeInsulinUnavailable: return "active insulin unknown"
+        case .aboveActiveInsulinLimit(let activeInsulin, let limit): return "IOB \(n(activeInsulin)) U would go over the \(n(limit)) U limit"
+        case .noSuspendThreshold: return "no glucose safety limit is set"
+        case .glucoseUnavailable: return "no recent glucose"
+        case .glucoseBelowSuspendThreshold(let glucose, let threshold): return "glucose \(g(glucose)) is below the safety limit \(g(threshold))"
+        case .forecastUnavailable: return "no forecast"
+        case .forecastBelowSuspendThreshold(let forecast, let threshold): return "forecast \(g(forecast)) would go below the safety limit \(g(threshold))"
+        case .podNotReady(let reason): return reason
+        }
+    }
+}
+// FENIX-QUEUE-CORE-END
+
+/// Runs the queue on the phone: the setting, the poll while something is queued, the delivery-time checks,
+/// the send through the normal manual-bolus path, and the notifications.
+@MainActor
+final class ManualBolusQueueController: ObservableObject {
+    static let enabledKey = "com.fenix.queueManualBolusWhenPodBusy"
+    static let pollInterval: TimeInterval = 5
+
+    @Published private(set) var queued: ManualBolusQueue.Item?
+
+    private var queue = ManualBolusQueue()
+    private var pollTask: Task<Void, Never>?
+    private unowned let loopDataManager: LoopDataManager
+    private let log = DiagnosticLog(category: "ManualBolusQueue")
+
+    init(loopDataManager: LoopDataManager) {
+        self.loopDataManager = loopDataManager
+    }
+
+    /// "Queue manual bolus when pod is busy" in Settings. Default OFF; when off everything is stock.
+    var isEnabled: Bool {
+        UserDefaults.standard.bool(forKey: Self.enabledKey)
+    }
+
+    var podSnapshot: ManualBolusQueue.PodSnapshot {
+        let status = loopDataManager.deliveryDelegate?.pumpManagerStatus
+        guard let status else {
+            return .init(hasPod: false, isSuspended: false, isBusy: false, isBusyWithAutomaticDelivery: false, notReadyReason: "no pod")
+        }
+        let isBusy: Bool
+        let isBusyWithAutomatic: Bool
+        switch status.bolusState {
+        case .noBolus:
+            isBusy = false; isBusyWithAutomatic = false
+        case .initiating:
+            // Loop itself starts the only boluses that initiate while this screen is up.
+            isBusy = true; isBusyWithAutomatic = true
+        case .inProgress(let dose):
+            isBusy = true; isBusyWithAutomatic = dose.automatic == true
+        case .canceling:
+            isBusy = true; isBusyWithAutomatic = false
+        }
+        var notReady: String?
+        var suspended = false
+        switch status.basalDeliveryState {
+        case .suspending, .suspended:
+            suspended = true; notReady = "pod is suspended"
+        case .resuming:
+            notReady = "pod is resuming"
+        case .pumpInoperable:
+            notReady = "pod is not working"
+        case nil:
+            notReady = "pod state unknown"
+        default:
+            break
+        }
+        return .init(hasPod: loopDataManager.deliveryDelegate?.isPumpConfigured == true, isSuspended: suspended,
+                     isBusy: isBusy, isBusyWithAutomaticDelivery: isBusyWithAutomatic, notReadyReason: notReady)
+    }
+
+    /// Units of the automatic bolus running now, when a manual bolus could queue behind it (nil units while initiating).
+    func automaticDeliveryInProgress() -> (units: Double?, busy: Bool) {
+        guard isEnabled, queued == nil else { return (nil, false) }
+        let pod = podSnapshot
+        guard pod.hasPod, !pod.isSuspended, pod.isBusyWithAutomaticDelivery else { return (nil, false) }
+        if case .inProgress(let dose)? = loopDataManager.deliveryDelegate?.pumpManagerStatus?.bolusState {
+            return (dose.programmedUnits, true)
+        }
+        return (nil, true)
+    }
+
+    func enqueue(units: Double, decisionId: UUID?, activationType: BolusActivationType) throws {
+        let item = try queue.enqueue(units: units, decisionId: decisionId, activationTypeRawValue: activationType.rawValue,
+                                     at: Date(), pod: podSnapshot)
+        queued = item
+        log.default("Queued %{public}@ U behind the automatic bolus", String(item.units))
+        startPolling()
+    }
+
+    func cancel() {
+        if let item = queue.cancel() {
+            log.default("Canceled queued %{public}@ U", String(item.units))
+        }
+        queued = nil
+        pollTask?.cancel()
+        pollTask = nil
+    }
+
+    private func startPolling() {
+        pollTask?.cancel()
+        pollTask = Task { @MainActor [weak self] in
+            while !Task.isCancelled {
+                guard let self, self.queued != nil else { return }
+                await self.poll()
+                try? await Task.sleep(nanoseconds: UInt64(Self.pollInterval * 1_000_000_000))
+            }
+        }
+    }
+
+    private func poll() async {
+        guard isEnabled else {
+            // The setting was turned off while something was queued: drop it, give nothing.
+            if let item = queue.cancel() {
+                Self.notify("Queued \(Self.units(item.units)) canceled", "The bolus queue was turned off. Nothing was delivered.")
+            }
+            queued = nil
+            return
+        }
+        let pod = podSnapshot
+        let early = queue.checkExpiry(now: Date())
+        if case .expired(let item) = early {
+            finish(.expired(item))
+            return
+        }
+        guard !pod.isBusy else { return }
+
+        let check = await deliveryCheck(for: queue.item?.units ?? 0)
+        finish(queue.stepWhenFree(now: Date(), check: check))
+    }
+
+    private func deliveryCheck(for units: Double) async -> ManualBolusQueue.DeliveryCheck {
+        // Refresh from the stores so IOB includes the automatic bolus that just finished.
+        await loopDataManager.updateDisplayState()
+        var check = ManualBolusQueue.DeliveryCheck(
+            maximumBolus: loopDataManager.maximumBolus,
+            activeInsulin: loopDataManager.displayState.activeInsulin?.value,
+            suspendThreshold: loopDataManager.suspendThreshold?.doubleValue(for: .milligramsPerDeciliter),
+            pod: podSnapshot)
+        do {
+            let now = Date()
+            let insulinModel = loopDataManager.insulinModel(for: loopDataManager.deliveryDelegate?.pumpInsulinType)
+            let dose = SimpleInsulinDose(deliveryType: .bolus, automatic: false, startDate: now, endDate: now, volume: units,
+                                         insulinModel: AlgorithmInsulinModel(insulinModel))
+            let (glucose, forecast) = try await loopDataManager.generatePrediction(carbEntryChange: nil, potentialDose: dose, manualGlucose: nil)
+            check.latestGlucose = glucose.last?.quantity.doubleValue(for: .milligramsPerDeciliter)
+            check.latestGlucoseDate = glucose.last?.startDate
+            check.minimumForecastWithDose = forecast.map { $0.mgdl }.min()
+        } catch {
+            log.error("Queued bolus check could not forecast: %{public}@", String(describing: error))
+        }
+        return check
+    }
+
+    private func finish(_ step: ManualBolusQueue.Step) {
+        switch step {
+        case .idle, .waiting:
+            return
+        case .expired(let item):
+            log.default("Queued %{public}@ U expired", String(item.units))
+            Self.notify("Queued \(Self.units(item.units)) not given", "The pod was still busy 10 minutes after you queued it. Nothing was delivered.")
+        case .notGiven(let item, let failure):
+            log.default("Queued %{public}@ U not given: %{public}@", String(item.units), ManualBolusQueue.describe(failure))
+            Self.notify("Queued \(Self.units(item.units)) not given", "\(ManualBolusQueue.describe(failure).prefix(1).uppercased())\(ManualBolusQueue.describe(failure).dropFirst()). Nothing was delivered.")
+        case .deliver(let item):
+            let activationType = BolusActivationType(rawValue: item.activationTypeRawValue) ?? .manualNoRecommendation
+            log.default("Sending queued %{public}@ U", String(item.units))
+            Task { @MainActor in
+                // The normal manual-bolus path: dose metadata, pump manager, dose store, uploads, IOB. A pump error
+                // there raises Loop's own "Bolus Issue" notification; this one says only that it was sent.
+                try? await self.loopDataManager.enactBolus(
+                    units: item.units,
+                    metadata: DoseMetadata(origin: .user, device: .phone, decisionId: item.decisionId),
+                    activationType: activationType.isAutomatic ? .manualNoRecommendation : activationType)
+                Self.notify("Queued \(Self.units(item.units)) sent to pod", "Sent after Loop's automatic bolus finished. If the pod refused it, Loop shows a Bolus Issue notification.")
+            }
+        }
+        queued = queue.item
+        if queued == nil {
+            pollTask?.cancel()
+            pollTask = nil
+        }
+    }
+
+    private static func units(_ value: Double) -> String {
+        let formatter = NumberFormatter()
+        formatter.minimumFractionDigits = 1
+        formatter.maximumFractionDigits = 2
+        formatter.minimumIntegerDigits = 1
+        return "\(formatter.string(from: NSNumber(value: value)) ?? String(value)) U"
+    }
+
+    private static var topViewController: UIViewController? {
+        guard let scene = UIApplication.shared.connectedScenes.compactMap({ $0 as? UIWindowScene }).first(where: { $0.activationState == .foregroundActive }),
+              var top = scene.windows.first(where: \.isKeyWindow)?.rootViewController else {
+            return nil
+        }
+        while let presented = top.presentedViewController {
+            top = presented
+        }
+        return top
+    }
+
+    /// One-button notice over the top-most screen.
+    static func inform(title: String, message: String) async {
+        guard let presenter = topViewController else { return }
+        await withCheckedContinuation { (continuation: CheckedContinuation<Void, Never>) in
+            let alert = UIAlertController(title: title, message: message, preferredStyle: .alert)
+            alert.addAction(UIAlertAction(title: "OK", style: .default) { _ in continuation.resume() })
+            presenter.present(alert, animated: true)
+        }
+    }
+
+    /// Yes/No question over the top-most screen. No screen -> No.
+    static func confirm(message: String) async -> Bool {
+        guard let presenter = topViewController else { return false }
+        return await withCheckedContinuation { continuation in
+            let alert = UIAlertController(title: "Pod is busy", message: message, preferredStyle: .alert)
+            alert.addAction(UIAlertAction(title: "No", style: .cancel) { _ in continuation.resume(returning: false) })
+            alert.addAction(UIAlertAction(title: "Yes", style: .default) { _ in continuation.resume(returning: true) })
+            presenter.present(alert, animated: true)
+        }
+    }
+
+    private static func notify(_ title: String, _ body: String) {
+        let content = UNMutableNotificationContent()
+        content.title = title
+        content.body = body
+        content.sound = .default
+        let request = UNNotificationRequest(identifier: "com.fenix.manualBolusQueue.\(UUID().uuidString)", content: content, trigger: nil)
+        UNUserNotificationCenter.current().add(request)
+    }
+}
