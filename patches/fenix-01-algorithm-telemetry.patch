+    // Fenix telemetry rides along in the stored decision and survives both encoders.
+    func testCodableAlgorithmTelemetry() throws {
+        var dosingDecision = StoredDosingDecision(date: dateFormatter.date(from: "2020-05-14T22:38:14Z")!,
