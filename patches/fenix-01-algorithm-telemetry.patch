+    /// Fenix telemetry for devicestatus `loop.testingDetails`: the dosing ("loop") decision's when there is one,
+    /// else this decision's. `fenixTelemetrySource` says which. Extra fields only; Nightscout stores them as-is.
+    func loopStatusTestingDetails(automaticDoseDecision: StoredDosingDecision?) -> [String: Any]? {
+        let source: String
+        let telemetry: JSONValue
+        if let loopTelemetry = automaticDoseDecision?.algorithmTelemetry {
+            source = automaticDoseDecision?.reason ?? "loop"
+            telemetry = loopTelemetry
+        } else if let ownTelemetry = algorithmTelemetry {
+            source = reason
+            telemetry = ownTelemetry
+        } else {
+            return nil
+        }
+        guard var details = telemetry.jsonObject as? [String: Any] else {
+            return nil
+        }
+        details["fenixTelemetrySource"] = source
+        return details
+    }
