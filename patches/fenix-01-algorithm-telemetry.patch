+            "momentumNet": .number(0),
+            "retrospectiveCorrectionApplied": .bool(true),
+            "retrospectiveCorrectionTotal": .number(12.5),
+            "latestGlucoseIsDisplayOnly": .bool(true),
+            "glucose": .array([.object(["date": .string("2020-05-14T22:35:00Z"), "isDisplayOnly": .bool(true)])])
+        ])
+        let decoded = try decoder.decode(StoredDosingDecision.self, from: encoder.encode(dosingDecision))
