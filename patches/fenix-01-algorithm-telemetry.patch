@@ -212,6 +212,44 @@ public extension StoredDosingDecision {
             self.carbsOnBoard = LoopKit.CarbValue(startDate: input.predictionStart, value: activeCarbs)
         }
         self.predictedGlucose = output.predictedGlucose.map(\.loopKit)
+        self.algorithmTelemetry = Self.algorithmTelemetry(input: input, output: output)
+    }
+
+    /// Fenix telemetry: what this run actually used, for Nightscout (devicestatus `loop.testingDetails`).
+    /// Informational only — computed from the run's input and output after the fact and never read back for
+    /// dosing. One builder, called for both the "loop" decision and the "updateRemoteRecommendation" decision.
+    static func algorithmTelemetry(input: StoredDataAlgorithmInput, output: AlgorithmOutput<StoredCarbEntry>) -> JSONValue {
+        let effects = output.effects
+        let windowStart = input.predictionStart.addingTimeInterval(-LoopAlgorithm.LoopMath.retrospectiveCorrectionGroupingInterval)
+        let recent = input.glucoseHistory.filter { $0.startDate >= windowStart && $0.startDate <= input.predictionStart }
+        let formatter = ISO8601DateFormatter()
+
+        func number(_ value: Double?) -> JSONValue {
+            value.map { .number(($0 * 100).rounded() / 100) } ?? .null
+        }
+        func bool(_ value: Bool?) -> JSONValue {
+            value.map { .bool($0) } ?? .null
+        }
+
+        var telemetry: [String: JSONValue] = [
+            "fenixTelemetryVersion": .number(1),
+            "momentumApplied": bool(effects.momentumApplied),
+            "momentumNet": number(effects.momentum.netEffect()?.quantity.doubleValue(for: .milligramsPerDeciliter)),
+            "retrospectiveCorrectionApplied": bool(effects.retrospectiveCorrectionApplied),
+            "retrospectiveCorrectionNet": number(effects.retrospectiveCorrection.netEffect()?.quantity.doubleValue(for: .milligramsPerDeciliter)),
+            "retrospectiveCorrectionTotal": number(effects.totalRetrospectiveCorrectionEffect),
+            "includePositiveVelocityAndRC": .bool(input.includePositiveVelocityAndRC),
+            "displayOnlyCount30m": .number(Double(recent.filter(\.isDisplayOnly).count)),
+            "glucoseCount30m": .number(Double(recent.count)),
+            "glucose": .array(recent.map {
+                .object(["date": .string(formatter.string(from: $0.startDate)), "isDisplayOnly": .bool($0.isDisplayOnly)])
+            })
+        ]
+        if let latest = input.glucoseHistory.last {
+            telemetry["latestGlucoseDate"] = .string(formatter.string(from: latest.startDate))
+            telemetry["latestGlucoseIsDisplayOnly"] = .bool(latest.isDisplayOnly)
+        }
+        return .object(telemetry)
     }
 }
 
