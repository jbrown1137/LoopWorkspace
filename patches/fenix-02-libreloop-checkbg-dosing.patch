+// MARK: - Fenix: "Dose from check-BG readings"
+
+extension LibreLoopGlucoseSample {
+    /// True when the sensor's advisory not-actionable bit is the only issue:
+    /// at least one issue, and every issue is `.notActionable`. Any warmup,
+    /// expiry, DQ error, sensor-condition fault or unavailable value -> false.
+    /// Written against the issue cases themselves (not `isAdvisory`) so a new
+    /// advisory kind added upstream can never be swept in by accident.
+    public static func onlyIssueIsNotActionable(_ issues: [Libre3GlucoseQualityIssue]) -> Bool {
+        guard !issues.isEmpty else { return false }
+        return issues.allSatisfy { issue in
+            if case .notActionable = issue { return true }
+            return false
+        }
+    }
+}
+
+/// Fenix: how a realtime reading maps to Loop's `isDisplayOnly`.
+///
+/// Switch OFF (the default): exactly stock LibreLoop -- any reading that is not
+/// fully actionable is forwarded display-only.
+///
+/// Switch ON: a reading whose ONLY issue is the sensor's not-actionable bit
+/// ("check BG"; on Jeff's Libre 3 Plus it is set for the first 12 h after
+/// sensor start) and that is an in-range realtime value is forwarded as a normal
+/// dosing reading. Everything else is unchanged: readings with a blocking issue
+/// are still dropped before this is asked, pegged 39/501 values and backfill
+/// keep their stock handling, and Loop's own limits (max bolus, max basal,
+/// suspend threshold, IOB limit) are untouched by this code.
+///
+/// Extension point (NOT implemented, Jeff has not chosen one): a first-12-h guard
+/// would be one more stored property here, consulted in `usesCheckBGForDosing`
+/// or in a richer return type, e.g. "only while sensor age >= N h", or "flag the
+/// sample so Loop allows only negative momentum/RC". Any guard must only ever
+/// make the result MORE conservative than switch-on.
+public struct LibreLoopCheckBGDosingPolicy: Equatable, Sendable {
+    public var doseFromCheckBGReadings: Bool
+
+    public init(doseFromCheckBGReadings: Bool) {
+        self.doseFromCheckBGReadings = doseFromCheckBGReadings
+    }
+
+    /// True when the switch turns this reading from display-only into a dosing reading.
+    public func usesCheckBGForDosing(_ sample: LibreLoopGlucoseSample) -> Bool {
+        doseFromCheckBGReadings
+            && !sample.isActionable
+            && sample.onlyIssueIsNotActionable
+            && !sample.hasBlockingIssue
+            && sample.condition == nil
+            && sample.source == .realtime
+    }
+
+    /// The `isDisplayOnly` value to forward to Loop for a realtime reading that
+    /// passed the blocking-issue check.
+    public func forwardsAsDisplayOnly(_ sample: LibreLoopGlucoseSample) -> Bool {
+        if sample.isActionable { return false }
+        return !usesCheckBGForDosing(sample)
+    }
+}
