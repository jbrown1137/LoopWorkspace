+// Fenix: "Dose from check-BG readings" mapping (default off = stock).
+final class LibreLoopCheckBGDosingPolicyTests: XCTestCase {
+    private let date = Date(timeIntervalSince1970: 1_700_000_000)
+
+    private func sample(issues: [Libre3GlucoseQualityIssue],
+                        condition: LibreLoopGlucoseSample.Condition? = nil,
+                        source: LibreLoopGlucoseSample.Source = .realtime) -> LibreLoopGlucoseSample {
+        LibreLoopGlucoseSample(
+            date: date,
+            valueMgDL: 220,
+            trend: .stable,
+            rateOfChangeMgDLPerMinute: 0.5,
+            lifeCount: 300,
+            sensorTemperatureRaw: 0,
+            isActionable: issues.isEmpty,
+            hasBlockingIssue: issues.contains { $0.isUsabilityBlocking },
+            onlyIssueIsNotActionable: LibreLoopGlucoseSample.onlyIssueIsNotActionable(issues),
+            condition: condition,
+            source: source
+        )
+    }
+
+    private let off = LibreLoopCheckBGDosingPolicy(doseFromCheckBGReadings: false)
+    private let on = LibreLoopCheckBGDosingPolicy(doseFromCheckBGReadings: true)
+    private let checkBG: Libre3GlucoseQualityIssue = .notActionable(.notActionable)
+
+    func testDefaultIsOff() {
+        XCTAssertFalse(LibreLoopCGMManagerState().doseFromCheckBGReadings)
+        XCTAssertFalse(LibreLoopCGMManagerState(rawValue: [:])!.doseFromCheckBGReadings)
+    }
+
+    func testSwitchPersists() {
+        var state = LibreLoopCGMManagerState()
+        XCTAssertNil(state.rawValue["doseFromCheckBGReadings"])
+        state.doseFromCheckBGReadings = true
+        XCTAssertEqual(LibreLoopCGMManagerState(rawValue: state.rawValue)?.doseFromCheckBGReadings, true)
+    }
+
+    func testCleanReadingDosesEitherWay() {
+        let clean = sample(issues: [])
+        XCTAssertFalse(off.forwardsAsDisplayOnly(clean))
+        XCTAssertFalse(on.forwardsAsDisplayOnly(clean))
+        XCTAssertFalse(on.usesCheckBGForDosing(clean))
+    }
+
+    func testCheckBGOnlyIsDisplayOnlyWhenOffAndDosingWhenOn() {
+        let flagged = sample(issues: [checkBG])
+        XCTAssertTrue(flagged.onlyIssueIsNotActionable)
+        XCTAssertTrue(off.forwardsAsDisplayOnly(flagged))
+        XCTAssertFalse(off.usesCheckBGForDosing(flagged))
+        XCTAssertFalse(on.forwardsAsDisplayOnly(flagged))
+        XCTAssertTrue(on.usesCheckBGForDosing(flagged))
+    }
+
+    func testAnyOtherIssueKeepsStockHandlingWithSwitchOn() {
+        let others: [[Libre3GlucoseQualityIssue]] = [
+            [.sensorWarmup(remainingMinutes: 20), checkBG],
+            [.sensorExpired, checkBG],
+            [.currentGlucoseUnavailable(.unavailable(raw: 0)), checkBG],
+            [.currentDataQuality(.sensorTooHot(rawValue: 1)), checkBG],
+            [.sensorCondition(.invalid), checkBG],
+            [.sensorCondition(.esa)],
+        ]
+        for issues in others {
+            let s = sample(issues: issues)
+            XCTAssertFalse(s.onlyIssueIsNotActionable, "\(issues)")
+            XCTAssertFalse(on.usesCheckBGForDosing(s), "\(issues)")
+            XCTAssertTrue(on.forwardsAsDisplayOnly(s), "\(issues)")
+            XCTAssertEqual(on.forwardsAsDisplayOnly(s), off.forwardsAsDisplayOnly(s), "\(issues)")
+        }
+    }
+
+    func testPeggedOrBackfilledCheckBGReadingStaysDisplayOnly() {
+        XCTAssertTrue(on.forwardsAsDisplayOnly(sample(issues: [checkBG], condition: .aboveRange)))
+        XCTAssertTrue(on.forwardsAsDisplayOnly(sample(issues: [checkBG], condition: .belowRange)))
+        XCTAssertFalse(on.usesCheckBGForDosing(sample(issues: [checkBG], source: .historicalBackfill)))
+    }
+
+    func testNoIssuesIsNotCheckBG() {
+        XCTAssertFalse(LibreLoopGlucoseSample.onlyIssueIsNotActionable([]))
+    }
+
+    func testForwardingOutcomeAndRawValueKeepTheFlags() {
+        let flagged = sample(issues: [checkBG])
+        let forwarded = flagged.withForwardingOutcome(wasForwarded: true, skipReason: nil, forwardedForDosingFromCheckBG: true)
+        XCTAssertTrue(forwarded.forwardedForDosingFromCheckBG)
+        XCTAssertFalse(flagged.withForwardingOutcome(wasForwarded: false, skipReason: "Throttled", forwardedForDosingFromCheckBG: true).forwardedForDosingFromCheckBG)
+        let restored = LibreLoopGlucoseSample(rawValue: forwarded.rawValue)
+        XCTAssertEqual(restored?.onlyIssueIsNotActionable, true)
+        XCTAssertEqual(restored?.forwardedForDosingFromCheckBG, true)
+        XCTAssertEqual(LibreLoopGlucoseSample(rawValue: sample(issues: []).rawValue)?.onlyIssueIsNotActionable, false)
+    }
+}
